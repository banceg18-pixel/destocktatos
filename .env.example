# ---------------------------------------------------------------------------
# Copiez ce fichier en `.env` puis adaptez les valeurs. Aucun secret réel ici.
# ---------------------------------------------------------------------------

# URL publique du frontend (sert aux canonicals, Open Graph, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de données (SQLite en local ; PostgreSQL/MySQL possibles en production)
DATABASE_URL="file:./dev.db"

# Authentification (NextAuth) — générez un secret : `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
# Connexion Google (optionnelle : les boutons n'apparaissent que si les deux valeurs sont définies).
# URI de redirection à déclarer dans Google Cloud : <NEXTAUTH_URL>/api/auth/callback/google (voir README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Source des contenus : "local" (base + fichiers data/) ou "wordpress"
CMS_PROVIDER=local
# WordPress Headless (utilisé si CMS_PROVIDER=wordpress)
WORDPRESS_API_URL=http://localhost:8080/wp-json
WORDPRESS_APPLICATION_USER=
WORDPRESS_APPLICATION_PASSWORD=

# Paiement par carte (Stripe). Sans clés, les clients confirment leur commande et la règlent par
# virement bancaire avant livraison (IBAN dans WordPress → Réglages → Site et magasin).
# Clés sk_test_ / pk_test_ en local, sk_live_ / pk_live_ en ligne.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Avec Stripe : true pour proposer aussi le virement bancaire.
BANK_TRANSFER=false

# Google Analytics 4 (optionnel, désactivé si vide ; chargé uniquement après consentement)
NEXT_PUBLIC_GA_ID=
# Balise de vérification Google Search Console (optionnelle)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Géocodage / autocomplétion d'adresse (Base Adresse Nationale, service public)
ADDRESS_API_URL=https://api-adresse.data.gouv.fr

# Stockage des pièces jointes des tickets d'assistance
UPLOAD_DIR=./uploads

# Webhook WordPress -> frontend (en-tête X-Tatos-Secret) : même valeur dans Réglages > Site et magasin
WORDPRESS_WEBHOOK_SECRET=
# Clé de l'administration WordPress (commandes, clients, stock…) : même valeur dans Réglages > Site et magasin.
# Générez-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_SECRET=
# Synchroniser aussi le stock depuis WordPress (sinon le stock est géré par les commandes)
WP_SYNC_STOCK=false
# Hôte des médias WordPress autorisé par next/image (ex. cms.exemple.fr)
WORDPRESS_MEDIA_HOST=

# Emails : sans serveur SMTP, les messages sont écrits dans ce dossier (consultables)
MAIL_OUTBOX_DIR=./outbox
# Envoi réel par SMTP (Brevo, Mailjet, OVH, Gmail…). Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché, ex. "TATOS <contact@votre-boutique.fr>"
MAIL_FROM=
# Durée du cache mémoire du catalogue en ms (0 = désactivé)
CATALOG_CACHE_TTL_MS=60000
# Destinataire des notifications du magasin (contact, devis, tickets)
STORE_NOTIFICATION_EMAIL=tatos-electromenager@outlook.com

# Meta (Facebook / Instagram) : Pixel et API Conversions. Laisser vide pour désactiver.
# Identifiant du Pixel (le même dans les deux variables), jeton de l'API Conversions, version de l'API Graph.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_GRAPH_VERSION=v21.0
