{
  "name": "tatos-headless",
  "version": "1.0.0",
  "private": true,
  "description": "Réplique full stack de la boutique TATOS (électroménager) — frontend Next.js prêt pour WordPress Headless, backend API + base de données.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:source-refs": "node scripts/audit-source-refs.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "wp:export": "tsx scripts/wp-export.ts",
    "wp:sync": "tsx --conditions=react-server scripts/wp-sync.ts",
    "wp:check": "tsx scripts/wp-check.ts",
    "test:e2e": "python tests/e2e/run_e2e.py",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run audit:source-refs && npm run audit:assets && npm run build && npm run test:e2e",
    "clean:test-data": "tsx scripts/clean-test-data.ts",
    "docs:plugin": "node scripts/docs-plugin.mjs",
    "vercel-build": "node scripts/build.mjs",
    "db:seed:postgres": "prisma generate --schema prisma/postgres/schema.prisma && tsx prisma/seed.ts && prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@stripe/react-stripe-js": "3.10.0",
    "@stripe/stripe-js": "7.9.0",
    "bcryptjs": "3.0.2",
    "minisearch": "7.2.0",
    "next": "15.5.28",
    "next-auth": "4.24.15",
    "nodemailer": "10.1.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-icons": "5.5.0",
    "server-only": "0.0.1",
    "stripe": "18.5.0",
    "swiper": "12.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.13",
    "tsx": "4.23.15",
    "typescript": "5.9.2",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@tailwindcss/oxide@4.1.13": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "postcss": "8.5.31",
    "deepmerge-ts": "8.0.2",
    "nodemailer": "$nodemailer"
  }
}
